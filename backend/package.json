{
  "name": "shakeabsen-backend",
  "version": "1.0.0",
  "description": "Backend API for student attendance verification system using Drizzle ORM and Geolib",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.15",
    "@hapi/boom": "^10.0.1",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "better-auth": "^1.6.15",
    "canvas": "^3.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "geolib": "^3.3.4",
    "helmet": "^8.2.0",
    "https-proxy-agent": "^9.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^10.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/xlsx": "^0.0.35",
    "drizzle-kit": "^0.31.10",
    "patch-package": "^8.0.1",
    "tsx": "^4.10.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
