# ================================================
# .env.instance2 — Environment untuk Instance ke-2
# ================================================
# Copy file ini ke .env.instance2 dan isi sesuai domain baru.
# Backend akan jalan di PORT=3002 (internal) agar tidak bentrok.
# Database akan terpisah (db_data_s2).

# --- Required ---
DATABASE_URL=mysql://hadirq:hadirq123@db-s2:3306/absensi
CORS_ORIGIN=https://sekolah2.sch.id
BETTER_AUTH_SECRET=buat-random-string-berbeda-dengan-instance1
BETTER_AUTH_URL=https://sekolah2.sch.id

# --- Database (optional) ---
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=absensi
MYSQL_USER=hadirq
MYSQL_PASSWORD=hadirq123

# --- Geofence (sesuaikan dengan sekolah) ---
SCHOOL_LATITUDE=-6.2088
SCHOOL_LONGITUDE=106.8456
SCHOOL_RADIUS_METERS=50
MAX_ACCURACY_METERS=30

# --- App ---
NODE_ENV=production
APP_TIMEZONE=Asia/Jakarta
KIOSK_SECRET_KEY=ganti-juga-untuk-instance2

# --- WhatsApp (opsional) ---
WA_PROXY_URL=
